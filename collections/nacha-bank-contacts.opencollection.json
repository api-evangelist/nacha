              }
            ],
            "params": [
              {
                "name": "bank_id",
                "value": "",
                "type": "path",
                "description": "9 digit financial institution routing transit number (RTN)"
              },
              {
                "name": "reason",
                "value": "",
                "type": "query",
                "description": "Reason for Inquiry * ACH_FRAUD - ACH fraud operations\n"
              }
            ]
          },
          "docs": "Financial institution contact information for fraud or operational issues"
        }
      ]
    }
  ],
  "bundled": true
